{
  "rewrites": [
    {
      "source": "/g/:id",
      "destination": "/app/gallery.html?g=:id"
    },
    {
      "source": "/c/:id",
      "destination": "/app/gallery.html?g=:id&as=couple"
    },
    {
      "source": "/c/:id/:key",
      "destination": "/app/gallery.html?g=:id&as=couple"
    },
    {
      "source": "/ph/:id",
      "destination": "/app/gallery.html?g=:id&as=photographer"
    },
    {
      "source": "/pg/:id",
      "destination": "/app/gallery.html?g=:id&as=picgrades"
    },
    {
      "source": "/p/:slug",
      "destination": "/app/gallery.html?p=:slug"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "functions": {
    "api/stream.js": {
      "includeFiles": "app/config.js"
    }
  }
}
